# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/Firple-Bold.font64
/filesystem/FiraMonoBold.font64
/filesystem/*.wav64
/filesystem/*.sprite

# Ignore external development tools
/tools/*
!/tools/phase3_discovery/
!/tools/phase3_discovery/main.c
!/tools/phase3_discovery/README.md
!/tools/phase3_discovery/Makefile
/tools/phase3_discovery/build/
/tools/phase3_discovery/*.z64

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store
